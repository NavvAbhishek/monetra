rules_version = '2';

// Baseline: each signed-in user can only access their own data under users/{uid}.
// Field validation (amountCents, colourIndex, lengths) is added in Phase 2 — see CLAUDE.md §5.3.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
